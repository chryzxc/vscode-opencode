{
  "compilerOptions": {
    "module": "preserve",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "dist",
    "sourceMap": true,
    "strict": true,
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "src/**/*.REFACTOR_GUIDE.ts",
    "src/**/REFACTOR_GUIDE.ts",
    "**/*.REFACTOR_GUIDE.ts"
  ]
}
