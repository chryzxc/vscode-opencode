**/*.map
**/*.map.js
dist/**/dist/
dist/**/*.map

# Source and test files
src/
**/src/**
**/*.ts
**/*.tsx
**/*.test.*
tests/
**/tests/**
*.test.*

# Config files
.vscode/**
.claude/**
.gitignore
.eslintignore
.eslintrc*
prettier.config*
tsconfig.json
vitest.config.*
jest.config.*
postcss.config.*
vite.config.*

