          return "";
        }
        if (trimmedChunk.startsWith(trimmedReply)) {
          return trimmedChunk
            .slice(trimmedReply.length)
            .replace(/^[\s:;,\-.!?]+/, "")
            .trim();
        }
        return trimmedChunk;
      };
      const cleanedReasoning = reasoning
        .map((chunk) =>
          stripAssistantEchoFromReasoning(chunk, messageText),
