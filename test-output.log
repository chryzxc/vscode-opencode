                stats.output += msg.tokens?.output || msg.info?.tokens?.output || 0;
                stats.read +=
                  msg.tokens?.cache?.read || msg.info?.tokens?.cache?.read || 0;
                stats.write +=
                  msg.tokens?.cache?.write || msg.info?.tokens?.cache?.write || 0;
                stats.duration +=
