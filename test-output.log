        const hasTextLike =
          partType === "" ||
          partType === "text" ||
          typeof rec.text === "string" ||
          typeof rec.content === "string";
        if (!hasTextLike) {
          return part;
        }
        replaced = true;
        return {
          ...(part as MessagePart),
          type: partType || "text",
          text: streamingContent,
        } as MessagePart;
