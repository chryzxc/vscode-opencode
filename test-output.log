                      })}
                      {subagents.length > 10 ? (
                        <button
                          type="button"
                          className="text-oc-2xs font-mono text-oc-accent hover:underline"
                          onClick={() => setShowAllSubagents((value) => !value)}
                        >
                          {showAllSubagents
                            ? "Show less"
                            : `Show all (${subagents.length})`}
                        </button>
                      ) : null}
                    </div>
                  </div>
                )}
