                  asString(asRecord(sanitized.info)?.id) ||
                  asString(sanitized.id) ||
                  responseMessageId ||
                  null;
                remapSubagentsToFinalMessageId(
                  dispatch,
                  getState,
                  [streamingMessageId, ...Array.from(activeSubagentParentMessageIds)],
