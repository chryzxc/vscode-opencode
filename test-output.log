                  const question = this.firstNonEmptyString(resp.questionText) || "";
                  if (!question) {
                    return `Answer ${index + 1}: ${answer}`;
                  }
                  return `Question ${index + 1}: ${question}\nAnswer: ${answer}`;
                })
                .filter((value) => value.length > 0)
