      }
    
      const prevChar = previous[previous.length - 1];
      const nextChar = next[0];
      if (/\s/.test(prevChar) || /\s/.test(nextChar)) {
        return false;
      }
      if (/^[,.;:!?)}\]]/.test(next)) {
        return false;
      }
      if (/[(\[{]$/.test(prevChar)) {
