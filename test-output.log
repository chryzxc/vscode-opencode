              } else {
                // No active stream — create an error-only message so the error banner
                // appears at the bottom of the message instead of at the top of the chat.
                const errorMessage: Message = {
                  id: `error-${Date.now()}`,
                  role: "assistant",
                  content: "",
                  error: errorMsg,
                  created: Date.now(),
