        normalized === "question" ||
        normalized === "question for you" ||
        normalized === "quick input" ||
        normalized === "wants" ||
        normalized === "want" ||
        normalized === "wants to" ||
        normalized === "ask" ||
        normalized === "asks" ||
        normalized === "asking" ||
        normalized === "awaiting your answer" ||
        normalized === "awaiting your response" ||
