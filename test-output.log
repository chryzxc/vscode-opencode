    }
    
    function isOpaqueSubagentToken(value: string): boolean {
      const text = value.trim();
      if (text.length < 8) {
        return false;
      }
      return (
        /^[a-f0-9-]{8,}$/i.test(text) ||
        /^msg[_-][a-z0-9-]+$/i.test(text) ||
        /^call[_-][a-z0-9-]+$/i.test(text) ||
        /^ses[_-][a-z0-9-]+$/i.test(text)
