        const entries = item
          .map((raw) => normalizeSubagentSummary(raw))
          .filter((entry): entry is SubagentSummary => !!entry);
        if (entries.length > 0) {
          out[key] = entries;
        }
      }
      return out;
    }
    
    function normalizeSubagentDetailMap(value: unknown): Record<string, SubagentDetail> {
      const rec = asRecord(value);
