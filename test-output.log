                    Array.isArray(normalizedMessage.parts)
                      ? (normalizedMessage.parts as MessagePart[])
                      : [],
                  );
                  if (mergedSteps.length > 0) {
                    normalizedMessage = {
                      ...normalizedMessage,
                      steps: mergedSteps,
                      progressEvents: mergedSteps,
                    };
                  }
                }
