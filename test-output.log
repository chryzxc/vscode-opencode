          const client = await this.serverManager.ensureRunning();
          const workspaceDirectory =
            vscode.workspace.workspaceFolders?.[0]?.uri.scheme === "file"
              ? vscode.workspace.workspaceFolders?.[0]?.uri.fsPath
                .replace(/\\/g, "/")
