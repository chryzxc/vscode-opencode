      const existingParts = Array.isArray(message.parts) ? [...message.parts] : [];
      const nextParts =
        existingParts.length > 0
          ? existingParts.map((part, index) => {
            if (index === 0 && (part.type === "text" || !part.type)) {
              return { ...part, type: "text", text: retryMessage };
            }
            return part;
          })
