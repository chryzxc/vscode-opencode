          })
          .filter((step): step is StructuredProgressUpdate => !!step)
        : [];
    
      const normalizeChoices = (raw: unknown): InteractiveChoice[] => {
        let candidate = raw;
        if (typeof candidate === "string") {
          try {
            candidate = JSON.parse(candidate);
