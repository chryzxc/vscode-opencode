          sources: Array.from(reasoningSources),
        };
      }
    
      const canonicalSteps = normalizeActivitySteps(
        normalized,
        streaming,
        sanitizedMergedParts as MessagePart[],
      );
      if (canonicalSteps.length > 0) {
