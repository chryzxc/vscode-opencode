        // });
    
        this.logger.info("History render parity", summaryContext);
    
        if (this.shouldVerboseStreamDebug()) {
          this.logger.debug("History raw tail (verbose)", {
            source,
            sessionId,
            items: rawSummary,
          });
          this.logger.debug("History processed tail (verbose)", {
            source,
            sessionId,
            items: processedSummary,
          });
