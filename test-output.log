      const reasoning = Array.isArray(reasoningRaw)
        ? reasoningRaw
          .filter((item): item is string => typeof item === 'string')
          .map((item) => item.trim())
          .filter(Boolean)
        : typeof reasoningRaw === 'string' && reasoningRaw.trim()
          ? [reasoningRaw.trim()]
          : [];
      const normalizeComparableText = (value: string): string =>
