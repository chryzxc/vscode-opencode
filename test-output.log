      const subagents = Array.isArray(subagentsRaw)
        ? subagentsRaw
          .map((item): StructuredSubagent | null => {
            const subagent = asRecord(item);
            if (!subagent) {
              return null;
            }
            const id = asString(subagent.id);
            if (!id) {
