    // WebView Logger - sends logs to extension for centralized logging
    class WebViewLogger {
      private logLevel: 'debug' | 'info' | 'warn' | 'error' = 'info';
      private sessionId: string | null = null;
    
      setSession(sessionId: string): void {
        this.sessionId = sessionId;
