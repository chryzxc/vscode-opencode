              console.debug(`[WebViewLogger] ${message}`, context);
              break;
            case 'info':
              console.info(`[WebViewLogger] ${message}`, context);
              break;
            case 'warn':
              console.warn(`[WebViewLogger] ${message}`, context);
              break;
            case 'error':
              console.error(`[WebViewLogger] ${message}`, context);
              break;
          }
        }
      }
    
