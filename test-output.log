        id,
        parentSessionId,
        parentMessageId,
        childSessionId: asString(rec.childSessionId) || undefined,
        agentId: asString(rec.agentId) || undefined,
        providerID: asString(rec.providerID) || undefined,
        modelID: asString(rec.modelID) || undefined,
