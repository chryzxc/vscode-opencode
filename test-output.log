                  hasBlockingInteractiveEvents(interactiveEvents);
                if (!suppressInteractiveReshow && interactiveEvents.length > 0) {
                  dispatch({
                    type: "SET_INTERACTIVE_EVENTS",
                    payload: interactiveEvents,
                  });
                }
    
