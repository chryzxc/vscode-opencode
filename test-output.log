        }
        if (!replyText) {
          return trimmedChunk;
        }
        const trimmedReply = replyText.trim();
        if (!trimmedReply) {
          return trimmedChunk;
        }
        if (
          normalizeComparableText(trimmedChunk) ===
          normalizeComparableText(trimmedReply)
