          event.callID || '',
          normalizeComparableText(event.title),
          normalizeComparableText(event.meta || ''),
          normalizeComparableText(event.filePath || ''),
          event.status,
        ].join('|');
        if (seen.has(key)) {
          continue;
        }
        seen.add(key);
        deduped.push(event);
      }
      return deduped;
