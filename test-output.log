                      eventType,
                      structuredKind,
                      partType,
                      finalContent: contentPatch.content,
                      structuredMessage: messageText,
                      streamingContent: streamingState?.content || "",
                    });
                  }
                } else {
                  const contentPatch = resolveStreamingContentUpdate(
                    streamingState?.content || '',
                    structuredMessage,
                    false,
                  );
