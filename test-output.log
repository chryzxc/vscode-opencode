          .filter((entry): entry is SubagentProgressEvent => !!entry)
        : [];
    
      const timelineEvents = Array.isArray(rec.timelineEvents)
        ? rec.timelineEvents
          .map((entry, index) => {
            const evt = asRecord(entry);
            if (!evt) {
