      streaming: StreamingState | null,
      sanitizedMergedParts: MessagePart[],
    ): MessageStep[] {
      const candidates: unknown[] = [];
      if (Array.isArray(message.steps)) {
        candidates.push(
          ...message.steps.map((step) => ({ ...step, source: step.source || "final" })),
