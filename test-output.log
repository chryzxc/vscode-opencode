     * {
     *   type: 'ready' | 'sendMessage' | 'createSession' | 'switchSession' |
     *         'deleteSession' | 'renameSession' | 'getSessions' | 'toggleMode' | 'getModels' |
     *         'selectModel' | 'getAgents' | 'selectAgent' | 'addToQueue' |
     *         'executeQueue' | 'clearQueue' | 'viewPlan' | 'openDiff',
     *   ...payload
     * }
     *
