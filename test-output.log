                                )}>
                                  <MarkdownRenderer
                                    content={event.summary}
                                    className="markdown-body"
                                  />
                                </div>
                              )
                            )}
    
                            {event.activityDetail?.diffExcerpt && (
                              <CompactDiffPreview
