                  asString(asRecord(sanitized.info)?.id) ||
                  asString(sanitized.id) ||
                  responseMessageId ||
                  null;
                const hydratedSubagentsFromState = collectHydratedSubagentsFromState(
                  getState(),
                  [
                    provisionalFinalMessageId,
                    streamingMessageId,
                    ...Array.from(activeSubagentParentMessageIds),
