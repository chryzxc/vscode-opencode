      const byCallId = new Map<string, SubagentProgressEvent>();
      const ordered: SubagentProgressEvent[] = [];
      for (const event of events) {
        if (!event.callID) {
          ordered.push(event);
          continue;
        }
        const current = byCallId.get(event.callID);
        if (!current) {
          byCallId.set(event.callID, event);
          ordered.push(event);
          continue;
