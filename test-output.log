                .filter((msg) => isRenderableHistoryMessage(msg));
              const messages =
                coalesceAdjacentAssistantHistoryMessages(normalizedMessages);
              const hydratedMessages = hydrateLegacyInteractiveUserMessages(messages);
              const dedupedHydratedMessages =
