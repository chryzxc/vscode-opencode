                        </span>
                      </div>
                      <pre className="max-h-[260px] overflow-auto rounded border border-oc-border bg-oc-panel-soft/60 p-2 text-[11px] leading-relaxed text-oc-text-soft whitespace-pre-wrap break-words font-mono">
