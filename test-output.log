        : [];
      const mergedReasoningEvents = [
        ...existingReasoningEvents,
        ...(streaming?.reasoningEvents ?? [])
      ];
      const reasoningSources = new Set<ActivitySource>();
      if (Array.isArray(streaming?.reasoningEvents) && streaming.reasoningEvents.length > 0) {
