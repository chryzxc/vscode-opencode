      if (!currentContent) {
        return { content: incomingChunk, append: false };
      }
    
      const withBoundary =
        fromDelta && needsBoundarySpace(currentContent, incomingChunk)
          ? ` ${incomingChunk}`
          : incomingChunk;
    
      if (fromDelta) {
        return { content: withBoundary, append: true };
