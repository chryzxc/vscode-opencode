{
  "name": "opencode-vscode",
  "displayName": "OpenCode",
  "description": "OpenCode integration for VS Code",
  "version": "0.1.0",
  "icon": "resources/extension-icon.png",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode-sidebar",
          "title": "OpenCode",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "opencode-sidebar": [
        {
          "type": "webview",
          "id": "opencode.chatView",
          "name": "Chat",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode.focus",
        "title": "OpenCode: Focus Chat"
      },
      {
        "command": "opencode.newSession",
        "title": "OpenCode: New Session"
      },
      {
        "command": "opencode.sendSelection",
        "title": "OpenCode: Send Selection to Chat"
      },
      {
        "command": "opencode.insertFileReference",
        "title": "OpenCode: Insert File Reference"
      },
      {
        "command": "opencode.installSkill",
        "title": "OpenCode: Install Skill"
      },
      {
        "command": "opencode.openMySkills",
        "title": "OpenCode: Open My Skills"
      },
      {
        "command": "opencode.refreshSkills",
        "title": "OpenCode: Refresh Skills"
      }
    ],
    "keybindings": [
      {
        "command": "opencode.focus",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "opencode.newSession",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape"
      },
      {
        "command": "opencode.insertFileReference",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      },
      {
        "command": "opencode.sendSelection",
        "key": "ctrl+l",
        "mac": "cmd+l"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "opencode.sendSelection",
          "when": "editorHasSelection",
          "group": "opencode"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "opencode.serverPort": {
          "type": "number",
          "default": 0,
          "description": "Port for OpenCode server (0 = auto-assign)"
        },
        "opencode.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start OpenCode server on activation"
        },
        "opencode.persistSessions": {
          "type": "boolean",
          "default": true,
          "description": "Persist chat sessions across VS Code restarts"
        },
        "opencode.logging.level": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Minimum log level to output"
        },
        "opencode.logging.enableConsole": {
          "type": "boolean",
          "default": true,
          "description": "Enable console output for logs"
        },
        "opencode.logging.enableFile": {
          "type": "boolean",
          "default": false,
          "description": "Enable file output for logs"
        },
        "opencode.logging.maxFileSize": {
          "type": "number",
          "default": 5242880,
          "description": "Maximum log file size in bytes before rotation (default: 5MB)"
        },
        "opencode.logging.maxFiles": {
          "type": "number",
          "default": 3,
          "description": "Maximum number of backup log files to keep"
        },
        "opencode.autoCompact": {
          "type": "boolean",
          "default": true,
          "description": "Automatically compact a session when context usage reaches the threshold"
        },
        "opencode.autoCompactThreshold": {
          "type": "number",
          "default": 0.9,
          "minimum": 0.5,
          "maximum": 0.99,
          "description": "Fraction of the model context limit at which auto-compaction fires (0.9 = 90%)"
        }
      }
    }
  },
  "scripts": {
    "build": "npm run structured-output:sync && npm run webview:build && npm run compile",
    "vscode:prepublish": "npm run build",
    "compile": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "webview:build": "npm run structured-output:sync && npm --prefix webview/shared run build",
    "webview:watch": "npm --prefix webview/shared run build -- --watch",
    "structured-output:sync": "node scripts/sync-structured-output-contract.mjs",
    "structured-output:check": "node scripts/sync-structured-output-contract.mjs --check",
    "test": "node --test tests/**/*.test.mjs",
    "test:webview-regression": "node --test tests/**/*.test.mjs",
    "lint": "eslint src --ext ts",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.19.8",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.2.24",
    "ajv": "^8.18.0",
    "axios": "^1.13.6",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "simple-git": "^3.33.0",
    "vscode-file-theme-processor": "^1.0.8"
  }
}
