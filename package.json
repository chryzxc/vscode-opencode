{
  "name": "opencode-vscode-chryzxc",
  "displayName": "OpenCode - AI Coding Agent for VS Code",
  "description": "OpenCode extension for VS Code with AI chat, coding agents, implementation plans, subagent tracking, code context attachments, and session history.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chryzxc/vscode-opencode.git"
  },
  "homepage": "https://github.com/chryzxc/vscode-opencode#readme",
  "bugs": {
    "url": "https://github.com/chryzxc/vscode-opencode/issues"
  },
  "version": "0.1.11",
  "icon": "resources/extension-icon.png",
  "publisher": "chryzxc",
  "galleryBanner": {
    "color": "#0b1220",
    "theme": "dark"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "opencode",
    "open code",
    "opencode vscode",
    "opencode ai",
    "vscode",
    "vs code",
    "vscode extension",
    "ai coding",
    "coding agent",
    "ai chat",
    "implementation plan",
    "plan builder",
    "subagent",
    "multi-agent",
    "code context",
    "session history",
    "quota",
    "mcp",
    "lsp",
    "code generation"
  ],
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode-sidebar",
          "title": "OpenCode",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "opencode-sidebar": [
        {
          "type": "webview",
          "id": "opencode.chatView",
          "name": "Chat",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode.focus",
        "title": "OpenCode: Focus Chat"
      },
      {
        "command": "opencode.newSession",
        "title": "OpenCode: New Session"
      },
      {
        "command": "opencode.sendSelection",
        "title": "OpenCode: Send Selection to Chat"
      },
      {
        "command": "opencode.insertFileReference",
        "title": "OpenCode: Insert File Reference"
      },
      {
        "command": "opencode.installSkill",
        "title": "OpenCode: Install Skill"
      },
      {
        "command": "opencode.openMySkills",
        "title": "OpenCode: Open My Skills"
      },
      {
        "command": "opencode.refreshSkills",
        "title": "OpenCode: Refresh Skills"
      },
      {
        "command": "opencode.restartServer",
        "title": "OpenCode: Restart Server"
      }
    ],
    "keybindings": [
      {
        "command": "opencode.focus",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "opencode.newSession",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape"
      },
      {
        "command": "opencode.insertFileReference",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      },
      {
        "command": "opencode.sendSelection",
        "key": "ctrl+l",
        "mac": "cmd+l"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "opencode.sendSelection",
          "when": "editorHasSelection",
          "group": "opencode"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "opencode.serverPort": {
          "type": "number",
          "default": 0,
          "description": "Port for OpenCode server (0 = auto-assign)"
        },
        "opencode.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start OpenCode server on activation"
        },
        "opencode.persistSessions": {
          "type": "boolean",
          "default": true,
          "description": "Persist chat sessions across VS Code restarts"
        },
        "opencode.logging.level": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Minimum log level to output"
        },
        "opencode.logging.enableConsole": {
          "type": "boolean",
          "default": true,
          "description": "Enable console output for logs"
        },
        "opencode.logging.enableFile": {
          "type": "boolean",
          "default": false,
          "description": "Enable file output for logs"
        },
        "opencode.logging.maxFileSize": {
          "type": "number",
          "default": 5242880,
          "description": "Maximum log file size in bytes before rotation (default: 5MB)"
        },
        "opencode.logging.maxFiles": {
          "type": "number",
          "default": 3,
          "description": "Maximum number of backup log files to keep"
        },
        "opencode.autoCompact": {
          "type": "boolean",
          "default": true,
          "description": "Automatically compact a session when context usage reaches the threshold"
        },
        "opencode.autoCompactThreshold": {
          "type": "number",
          "default": 0.9,
          "minimum": 0.5,
          "maximum": 0.99,
          "description": "Fraction of model context limit at which auto-compaction fires (0.9 = 90%)"
        },
        "opencode.autoGenerateSessionTitle": {
          "type": "boolean",
          "default": true,
          "description": "Automatically generate session title from first message"
        },
        "opencode.requestTimeout": {
          "type": "number",
          "default": 120000,
          "minimum": 10000,
          "maximum": 600000,
          "description": "Request timeout in milliseconds for API calls (default: 120s, min: 10s, max: 10min)",
          "scope": "window",
          "order": 10
        },
        "opencode.complexQueryMultiplier": {
          "type": "number",
          "default": 1.5,
          "minimum": 1,
          "maximum": 3,
          "description": "Timeout multiplier for complex queries with multiple files or contexts (default: 1.5x)",
          "scope": "window",
          "order": 11
        }
      }
    }
  },
  "scripts": {
    "build": "npm run structured-output:sync && npm run webview:build && npm run compile",
    "verify": "npm run structured-output:check && npm run build && npm run lint && npm test",
    "vscode:prepublish": "npm run build",
    "compile": "node esbuild.config.cjs",
    "watch": "node esbuild.config.cjs --watch",
    "dev": "node scripts/dev-simple.mjs",
    "dev:full": "node scripts/dev-hotreload.mjs",
    "webview:build": "npm run structured-output:sync && npm --prefix webview/shared run build",
    "webview:watch": "npm --prefix webview/shared run build -- --watch",
    "structured-output:sync": "node scripts/sync-structured-output-contract.mjs",
    "structured-output:check": "node scripts/sync-structured-output-contract.mjs --check",
    "hooks:install": "node scripts/setup-git-hooks.mjs",
    "test:impacted": "node scripts/pre-push-check.mjs --tests-only",
    "guard:prepush": "node scripts/pre-push-check.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "test:ts": "tsx node --test tests/**/*.test.ts",
    "test:integration": "tsx --import tests/integration/helpers/register-vscode-mock.ts node --test 'tests/integration/**/*.test.ts'",
    "test:webview-regression": "node --test tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && eslint src --ext ts",
    "package": "npx @vscode/vsce package",
    "package:marketplace": "sh -c 'test -n \"$VSCE_BASE_IMAGES_URL\" || { echo \"VSCE_BASE_IMAGES_URL is required\"; exit 1; }; npx @vscode/vsce package --baseImagesUrl \"$VSCE_BASE_IMAGES_URL\" --baseContentUrl \"${VSCE_BASE_CONTENT_URL:-$VSCE_BASE_IMAGES_URL}\"'",
    "publish:marketplace": "sh -c 'test -n \"$VSCE_BASE_IMAGES_URL\" || { echo \"VSCE_BASE_IMAGES_URL is required\"; exit 1; }; npx @vscode/vsce publish --baseImagesUrl \"$VSCE_BASE_IMAGES_URL\" --baseContentUrl \"${VSCE_BASE_CONTENT_URL:-$VSCE_BASE_IMAGES_URL}\"'",
    "analyze-logs": "npx tsx scripts/analyze-logs.ts logs/opencode.log",
    "analyze-logs:summary": "npx tsx scripts/analyze-logs.ts logs/opencode.log --summary",
    "analyze-logs:flows": "npx tsx scripts/analyze-logs.ts logs/opencode.log --flows",
    "analyze-logs:errors": "npx tsx scripts/analyze-logs.ts logs/opencode.log --errors",
    "analyze-logs:perf": "npx tsx scripts/analyze-logs.ts logs/opencode.log --performance"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "esbuild": "^0.28.0",
    "eslint": "^8.54.0",
    "jsdom": "^29.0.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.4.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.13.6",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "simple-git": "^3.33.0",
    "vite": "^8.0.8",
    "vscode-file-theme-processor": "^1.0.8"
  }
}
